<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        起動可能アプリ列挙のためのパッケージ可視性宣言。
        QUERY_ALL_PACKAGES は使わず、ACTION_MAIN + CATEGORY_LAUNCHER で
        解決できるActivityのみを対象にする (Android 11+ で必要)。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:theme="@style/AppTheme"
        android:label="Pixel Tag Drawer"
        android:allowBackup="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            Pinned Shortcut 専用の中継 Activity (画面なし)。
            通常ランチャー task と分離するため taskAffinity="" / excludeFromRecents="true" を指定する。
            LAUNCHER カテゴリは付けない (ホームの通常アイコンにはしない)。
            ランチャー (別アプリ) からショートカット経由で起動されるため exported="true"。
        -->
        <activity
            android:name=".ShortcutEntryActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

    </application>

</manifest>
